# 复制为 .env 后填入。未配置则自动 Mock 降级,项目仍可跑(design.md §9)。
# ⚠️ 请勿提交真实 Key:.env 已在 .gitignore;本文件只放空占位,提交前务必确认无真实密钥。

# MiniMax-M3 多模态(Anthropic 兼容直连)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_LLM_MODEL=MiniMax-M3

# 阿里百炼 Paraformer 实时 ASR(移动端,PR2 接入)
BAILIAN_API_KEY=
BAILIAN_ASR_MODEL=paraformer-realtime-v2

# 档位(免费地板;付费档调大)— design.md §11/§24
PLAN_TEXT_HISTORY_TURNS=10
